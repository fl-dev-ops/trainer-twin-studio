# Required — where voices live (the Next.js app owns voice identity)
APP_BASE_URL=http://localhost:3000
APP_API_KEY=change-me-long-random     # shared secret TTS <-> Next.js

# Optional — vLLM-Omni backend (default http://localhost:8001 via docker-compose)
TTS_BACKEND_URL=http://tts-backend:8001
VOXCPM_MODEL_ID=voxcpm2               # advertised model name in /v1/models
VOXCPM_MODEL=openbmb/VoxCPM2
TTS_SAMPLE_RATE=48000                 # VoxCPM2 emits 48 kHz mono
TTS_MAX_TEXT_CHARS=5000
TTS_API_KEY=                          # unset = no auth on /v1/*; set to require Bearer

# Optional — only if openbmb/VoxCPM2 requires a Hugging Face token
HF_TOKEN=
