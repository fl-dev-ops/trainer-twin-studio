# Required — where voices live (the Next.js app owns voice identity)
APP_BASE_URL=http://localhost:3000
APP_API_KEY=change-me-long-random     # shared secret TTS <-> Next.js

# Optional — vLLM-Omni backend (default http://localhost:8001 via docker-compose)
TTS_BACKEND_URL=http://tts-backend:8001
VOXCPM_MODEL_ID=voxcpm2               # advertised model name in /v1/models
VOXCPM_MODEL=openbmb/VoxCPM2
TTS_SAMPLE_RATE=48000                 # VoxCPM2 emits 48 kHz mono
TTS_MAX_TEXT_CHARS=5000
TTS_API_KEY=change-me-long-random    # required by docker-compose; never expose an unauthenticated proxy

# Optional versioned voice features, generated before starting the backend.
# Compose mounts this host directory read-only in both containers.
TTS_PROFILE_SOURCE=./voices
TTS_CUSTOM_VOICE_DIR=/srv/tts/voices
VOXCPM_MODEL_REVISION=7936080b41163874f38610f46f438e2c0757f9fd
TTS_BACKEND_TIMEOUT_SECONDS=90
VOICE_CACHE_TTL_SECONDS=300            # voice updates/deletions take effect after refresh/invalidation

# Optional — only if openbmb/VoxCPM2 requires a Hugging Face token
HF_TOKEN=
