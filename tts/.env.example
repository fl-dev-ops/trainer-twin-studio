# Required — where voices live (the Next.js app owns voice identity)
APP_BASE_URL=http://localhost:3000
APP_API_KEY=change-me-long-random     # shared secret TTS <-> Next.js

# Required — the S3 bucket is accessed by the APP, not this service; this
# service only follows presigned URLs. Kept here so `httpx` fetches work in
# restricted networks. No AWS creds needed by this container.

# Optional
VOXCPM_MODEL_ID=voxcpm2         # advertised model name in /v1/models
VOXCPM_MODEL=openbmb/VoxCPM2    # or a local path to pre-downloaded weights
LOAD_DENOISER=false             # true = better input denoising, slower startup
TTS_CACHE_DIR=/tmp/trainertwin-tts-cache
TTS_CFG_VALUE=2.0               # higher = more adherence to the reference style
TTS_INFERENCE_TIMESTEPS=10      # higher = better quality, slower
TTS_MAX_TEXT_CHARS=5000
TTS_API_KEY=                    # unset = no auth on /v1/*; set to require Bearer
