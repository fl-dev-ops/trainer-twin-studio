# Web app (Studio) this agent serves; the web proxy authenticates with orgId:COPILOT_SERVICE_SECRET.
STUDIO_URL=http://localhost:3000
COPILOT_SERVICE_SECRET=
# publish sends scenarios to STUDIO_URL/api/internal/scenario-runs and /scenarios (same value as web's).
SCENARIO_INGEST_SECRET=

# Model (agent/lib/model.ts)
CEREBRAS_API_KEY=

# Trainer sources and run outputs (agent/lib/origin.ts). Unset locally: INGEST_USERS / INGEST_OUTPUT folders.
INGEST_S3_BUCKET=
INGEST_S3_PREFIX=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
INGEST_USERS=
INGEST_OUTPUT=
