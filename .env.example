# Topic classification (closed-set tagging during ingestion)
TOPIC_MODEL=openai/gpt-4o-mini

# YouTube worker configuration; match the web backend (never expose via NEXT_PUBLIC_*).
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Keep disabled: retained maintenance code includes transcript/vector deletion.
YOUTUBE_MAINTENANCE_ENABLED=false
