# TrainerTwin voice agent
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini
SARVAM_API_KEY=
ASSEMBLYAI_API_KEY=
SARVAM_SPEAKER=rohan
SARVAM_TTS_MODEL=bulbul:v3
# Path to the synthesizer POC whose runtime this agent imports
POC_PATH=../../synthesizer/poc

# URL of the studio web app (for /api/agent-config and session records)
WEB_URL=http://localhost:3000
# Optional: force a voice ID (useful when local specs point at a different app database)
AGENT_VOICE_ID_OVERRIDE=

