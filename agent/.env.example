# LiveKit project credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
AGENT_NAME=intervoo-agent

# Deepgram (STT)
DEEPGRAM_API_KEY=

# Studio Web App URL (used for LLM runtime /api/v1, TTS /api/tts/speech, and webhook /api/sessions/webhook)
WEB_URL=https://trainertwin.localhost

# TTS Provider: voxcpm2 (default) or sarvam
TTS_PROVIDER=voxcpm2
SARVAM_API_KEY=
SARVAM_SPEAKER=rohan

# Recording and S3 session artifacts (optional)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BASE_PREFIX=trainertwin-dev
