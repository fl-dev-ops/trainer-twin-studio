{
  "name": "trainertwin-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "portless docs.trainertwin sh -c 'mint dev --no-open --port \"$PORT\"'",
    "dev:direct": "mint dev --no-open",
    "validate": "mint validate",
    "check:links": "mint broken-links",
    "check:a11y": "mint a11y"
  },
  "devDependencies": {
    "mint": "4.2.857",
    "portless": "0.15.6"
  }
}
