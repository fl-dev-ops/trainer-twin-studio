{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": { "@/*": ["../web/*"] },
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
