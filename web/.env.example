# Studio
NEXT_PUBLIC_AGENT_URL=http://localhost:7860
NEXT_PUBLIC_DOCS_URL=https://docs.trainertwin.localhost

# LiveKit
LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=intervoo-agent

# Standalone Eve Copilot
# Studio copilot (copilot/ app, `eve dev` on :2001); the chat app (CHAT_URL) is the twin/role-play runtime.
EVE_ORIGIN=http://localhost:2001
CHAT_URL=http://localhost:2000
COPILOT_SERVICE_SECRET=
# Bearer secret for POST /api/internal/scenarios (scenario-ingest agent)
SCENARIO_INGEST_SECRET=

# S3 (knowledge document storage)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_BASE_PREFIX=trainertwin-dev
WHITEBOARD_EVALUATION_SIGNING_SECRET=
WHITEBOARD_VISION_MODEL=openai/gpt-4o

# ChromaDB Cloud dev account (one database is provisioned per organization ID)
CHROMA_API_KEY=
CHROMA_TENANT=
# For self-hosted Chroma instead:
# CHROMA_URL=http://localhost:8000
# Vercel AI Gateway (chat completions, embeddings, and models)
# On Vercel deployments, VERCEL_OIDC_TOKEN is provided automatically.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Legacy / fallback OpenRouter credentials also accepted:
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://ai-gateway.vercel.sh/v1

# Firecrawl (web search for copilot + future studio features)
FIRECRAWL_API_KEY=

# Gemini API (for video/audio persona source analysis)
GEMINI_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
RERANK_MODEL=cohere/rerank-v3.5

# Code execution (OneCompiler, session code editor)
ONECOMPILER_API_KEY=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://auth.trainertwin.localhost
# Google Cloud OAuth "Web application" credentials (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud authorized redirect URI (production):
# https://auth.trainertwin.com/api/auth/callback/google
# For local OAuth testing, use a Google-accepted localhost callback or a staging HTTPS domain;
# Google may reject custom *.localhost hostnames as redirect URIs.

# Google Drive: selected-file imports only (no background sync).
# Enable Google Drive API + Google Picker API in the same Google Cloud project.
# Use a Web application OAuth client with the callback below; restrict the browser API key to Picker + studio origins.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Production uses the HTTPS studio callback; for local development set:
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/connectors/google-drive/oauth/local-callback
GOOGLE_DRIVE_REDIRECT_URI=https://dash.trainertwin.com/api/connectors/google-drive/oauth/callback
GOOGLE_DRIVE_PICKER_API_KEY=
GOOGLE_DRIVE_PROJECT_NUMBER=
# Generate a dedicated 32-byte base64 key: openssl rand -base64 32
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# Resend Email
RESEND_API_KEY=
RESEND_FROM_EMAIL="TrainerTwin <no-reply@trainertwin.com>"

# PostHog (client analytics + session replay)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Razorpay: customers pay invoices online (billing phase 3, lib/billing/razorpay.ts; specs/billing.md rules 27–35), and
# phase 1 credit purchases (lib/credit-purchases.ts). Off unless RAZORPAY_ENABLED=true (then: bank transfer only).
# Test keys locally (rzp_test_…), live keys in production.
RAZORPAY_ENABLED=
# Webhook secret: the one set on the Razorpay webhook (Dashboard › Webhooks → /api/razorpay/webhook).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meteroid: org credits (lib/org-credits.ts). Sandbox key locally (pv_dev_…), a production key in production.
# Webhook secret: the one Meteroid shows when the webhook (Meteroid › Webhooks → /api/meteroid/webhook) is created.
METEROID_API_URL=https://meteroid-rest.foreverlearning.in/api/v1
METEROID_API_KEY=
METEROID_WEBHOOK_SECRET=
# Billing phase 2 (specs/billing.md), all optional: Meteroid's dashboard API (voiding invoices), the sender of billing
# emails, how to pay (shown in invoice emails, e.g. bank transfer details), and the LUT reference on export invoices.
METEROID_GRPC_URL=https://meteroid-api.foreverlearning.in
BILLING_FROM_EMAIL="TrainerTwin Billing <billing@trainertwin.com>"
BILLING_PAYMENT_INSTRUCTIONS=
GST_LUT_REFERENCE=
