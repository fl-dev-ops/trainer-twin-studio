# Studio
NEXT_PUBLIC_AGENT_URL=http://localhost:7860

# Standalone Eve Copilot
EVE_ORIGIN=http://localhost:2000
COPILOT_SERVICE_SECRET=

# S3 (knowledge document storage)
AWS_REGION=
# Vercel producer: standard SQS queue consumed by the Notion ingestion Lambda.
INGESTION_QUEUE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_BASE_PREFIX=trainertwin/kb

# ChromaDB (knowledge vector store)
CHROMA_URL=http://localhost:8000
# Set all three to use Chroma Cloud; otherwise CHROMA_URL is used.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# OpenRouter (embeddings + reranking; LLM_API_KEY also accepted)
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
RERANK_MODEL=cohere/rerank-v3.5

# Code execution (OneCompiler, session code editor)
ONECOMPILER_API_KEY=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://trainertwin.localhost

# Notion public OAuth + encrypted per-trainer workspace tokens
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=https://dash.trainertwin.localhost/api/notion/oauth/callback
# Generate once with: openssl rand -base64 32
NOTION_TOKEN_ENCRYPTION_KEY=
NOTION_API_VERSION=2026-03-11

# YouTube: owner-only OAuth, English captions. Same credentials/key in the worker.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Exact callback URL registered in Google Auth Platform; no guessed production domain.
YOUTUBE_OAUTH_REDIRECT_URI=
# Separate from NOTION_TOKEN_ENCRYPTION_KEY; generate with openssl rand -base64 32.
YOUTUBE_TOKEN_ENCRYPTION_KEY=
