generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Studio specs ----

model Persona {
  orgId     String?
  id        String          @id @default(cuid())
  slug      String
  name      String
  version   Int             @default(1)
  data      Json
  // The user's own persona (a real person: recordings, style, cloned voice). Never true for a
  // global persona (orgId null). Immutable; twins require it (DB triggers, see migration split_twin_roleplay).
  isOwn     Boolean         @default(false)
  // Persona = voice + avatar + prompt fields (data) + program settings. It owns its voice and avatar
  // (unique); both share its org (trigger, migration persona_media).
  voiceId   String?         @unique
  voice     Voice?          @relation(fields: [voiceId], references: [id], onDelete: SetNull)
  avatarId  String?         @unique
  avatar    Avatar?         @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  // Program settings: runtime behaviour the agent never reads (e.g. { pace }). JSON object (CHECK).
  settings  Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sources   PersonaSource[]
  agents    Agent[]

  @@unique([orgId, slug])
  @@index([orgId])
}

/// Which module an agent belongs to. Immutable once set (DB trigger).
enum AgentKind {
  TWIN
  ROLEPLAY

  @@map("agent_kind")
}

model Agent {
  orgId           String?
  visibility      String             @default("public") // public | private (within the org)
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  version         Int                @default(1)
  personaId       String
  persona         Persona            @relation(fields: [personaId], references: [id], onDelete: Restrict)
  // No default: every writer must choose the module.
  kind            AgentKind
  data            Json
  order           Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deployments     Deployment[]
  sessions        InterviewSession[]
  twinAssignments TwinAssignment[]
  twinShareLinks  TwinShareLink[]

  @@index([orgId])
  @@index([personaId])
  @@index([orgId, kind])
  @@index([personaId, kind])
}

// Immutable snapshot taken on every changed save. entityData in {persona|agent}

model SpecVersion {
  orgId      String?
  id         String   @id @default(cuid())
  entityType String
  entitySlug String
  version    Int
  data       Json
  createdAt  DateTime @default(now())

  @@unique([orgId, entityType, entitySlug, version])
  @@index([entityType, entitySlug])
  @@index([orgId])
}

// ---- Copilot working drafts ----

model SpecDraft {
  orgId         String?
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  personaSlug   String?
  // Copied onto the Agent when published. No default: every writer must choose.
  kind          AgentKind
  agentData     Json
  groundingData Json
  assumptions   Json
  gaps          Json
  status        String    @default("draft") // draft | published
  revision      Int       @default(1)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  revisions SpecDraftRevision[]

  @@index([orgId])
  @@index([orgId, kind])
}

model SpecDraftRevision {
  id        String   @id @default(cuid())
  draftId   String
  revision  Int
  data      Json
  createdAt DateTime @default(now())

  draft SpecDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, revision])
  @@index([draftId])
}

// Invite-only platform: a founder invite authorizes one person to create one
// organization (with themselves as owner) through the onboarding flow.
model FounderInvite {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String?
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("founder_invite")
}

// ---- Knowledge ----

model KnowledgeBase {
  orgId     String?
  id        String   @id @default(cuid())
  slug      String
  name      String
  createdAt DateTime @default(now())

  organization       Organization?       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents          KnowledgeDocument[]
  sources            KnowledgeSource[]
  notionOAuthStates  NotionOAuthState[]
  youtubeOAuthStates YouTubeOAuthState[]

  @@unique([orgId, slug])
  @@index([orgId])
}

model KnowledgeDocument {
  id                String    @id @default(cuid())
  kbId              String
  sourceId          String?
  externalId        String?
  externalUpdatedAt DateTime?
  parentExternalId  String?
  slug              String
  title             String
  ext               String
  size              Int
  s3SourceKey       String
  s3MarkdownKey     String?
  s3QuestionsKey    String?
  status            String    @default("uploaded") // uploaded | queued | digesting | indexed | failed
  error             String?
  indexedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  kb     KnowledgeBase    @relation(fields: [kbId], references: [id], onDelete: Cascade)
  source KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([kbId, slug])
  @@unique([sourceId, externalId])
  @@index([sourceId])
}

// ---- Learner context (resumes etc.) ----

// Trainer voice for TTS cloning. Audio + transcript in S3 under
// {basePrefix}/tts-voices/{id}/; identity is a cuid so names can never collide.

model Voice {
  orgId           String?
  id              String   @id @default(cuid())
  name            String
  kind            String   @default("cloned") // sample | cloned
  status          String   @default("ready") // ready | failed
  s3AudioKey      String
  s3TranscriptKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  persona         Persona?

  @@index([orgId])
}

// Reference files for the AI avatar model: an image and a video (whichever the model needs).
// Owned by one persona; files under {basePrefix}/{org}/avatars/{id}/ (or global/avatars for presets).
model Avatar {
  id           String        @id @default(cuid())
  orgId        String?
  name         String
  // The photo shown everywhere; for a trainer's own capture, the professional headshot generated from the original.
  s3ImageKey   String?
  // The photo as taken (Twin's brain capture), kept for regenerating the headshot.
  s3OriginalImageKey String?
  s3VideoKey   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  persona      Persona?

  @@index([orgId])
}

model ContextDocument {
  orgId            String?
  id               String                     @id @default(cuid())
  ownerUserId      String?
  name             String
  mimeType         String
  kind             String                     @default("document") // "document" | "image"
  content          Bytes
  size             Int
  sha256           String?
  extractedText    String?
  manifest         Json?
  createdAt        DateTime                   @default(now())
  sessions         InterviewSession[]
  chunks           ContextDocumentChunk[]
  claims           ResumeClaim[]
  sessionDocuments InterviewSessionDocument[]
  owner            User?                      @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([orgId, ownerUserId])
}

model ContextDocumentChunk {
  id         String          @id @default(cuid())
  documentId String
  document   ContextDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  heading    String?
  pageNumber Int?
  text       String

  @@index([documentId])
}

/// A questionable statement extracted from an uploaded resume (Resume Mastery v1).
/// Extraction happens once per document at ingestion; sessions reuse the stored
/// claims. `anchor` is a short literal excerpt the learner's PDF viewer
/// highlights by text search — no PDF coordinates are stored.
model ResumeClaim {
  id         String          @id @default(cuid())
  documentId String
  document   ContextDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  claimNo    Int // stable ordering within the document
  section    String // resume section heading the claim came from
  kind       String // project | experience | impact | architecture | technology | education | other
  text       String // verbatim claim text from the resume
  anchor     String // literal viewer-search anchor for the highlight
  metric     String? // exact substring of text, when the claim quantifies impact
  createdAt  DateTime        @default(now())

  @@unique([documentId, claimNo])
  @@index([documentId])
}

model InterviewSessionDocument {
  sessionId  String
  documentId String
  createdAt  DateTime         @default(now())
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  document   ContextDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([sessionId, documentId])
  @@index([sessionId])
  @@index([documentId])
}

// ---- Persona source ingestion ----

// Raw source materials (videos, transcripts, chat histories, docs) uploaded
// to build or improve a persona. Analysis results are stored in `analysis`.
model PersonaSource {
  id        String   @id @default(cuid())
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  orgId     String
  kind      String // "video" | "audio" | "chat" | "document" | "transcript"
  name      String // original filename
  s3Key     String // S3 object key for raw upload
  status    String   @default("uploaded") // uploaded | analyzing | analyzed | compiling | failed
  analysis  Json? // extracted behavioral observations from Gemini
  metadata  Json? // { size, mimeType, error?, voiceMoments? }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personaId])
  @@index([orgId])
}

// ---- Interview sessions ----

// Interview practice run by a signed-in user of an organization.
model InterviewSession {
  id               String    @id @default(cuid())
  orgId            String
  userId           String
  agentId          String
  shareCode        String    @unique
  runtimeTokenHash String?   @unique
  personaSlug      String
  personaVersion   Int
  agentSlug        String
  agentVersion     Int
  status           String    @default("assigned") // assigned | activating | active | closing | completed | abandoned | revoked | failed
  contextId        String?
  contextName      String?
  transcript       Json?
  evidence         Json?
  s3AudioKey       String?
  report           Json?
  reportStatus     String?   @default("none") // none | generating | completed | failed
  // Twin sessions: the Vercel Workflow run that generates the report (dedupe and status checks).
  reportWorkflowRunId String?
  feedbackRating   Int?
  feedbackNote     String?
  attempt          Int       @default(1)
  compiledSnapshot Json?
  runtimeState     Json?
  warmOpening      Json?
  runtimeRevision  Int       @default(0)
  lastCompletion   Json?
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  endedAt          DateTime?
  deletedAt        DateTime?

  organization      Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user              User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  agent             Agent                      @relation(fields: [agentId], references: [id], onDelete: Restrict)
  context           ContextDocument?           @relation(fields: [contextId], references: [id], onDelete: SetNull)
  documents         InterviewSessionDocument[]
  commands          WorkspaceCommand[]
  deploymentId      String?
  assignmentId      String?
  mode              String                     @default("voice") // voice | chat
  activationKey     String?                    @unique
  livekitRoom       String?
  livekitDispatchId String?
  audioEgressId     String?
  videoEgressId     String?

  deployment       Deployment?         @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  assignment       RolePlayAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  // Twin sessions only; never together with assignmentId (CHECK session_one_assignment_kind). Minutes used
  // are the sum of these sessions' startedAt..endedAt.
  twinAssignmentId String?
  twinAssignment   TwinAssignment?     @relation(fields: [twinAssignmentId], references: [id], onDelete: SetNull)
  twinCalibration  TwinCalibration?
  turnEvidence     TwinTurnEvidence[]

  @@index([orgId, userId])
  @@index([agentId])
  @@index([deploymentId])
  @@index([assignmentId])
  @@index([twinAssignmentId])
}

model User {
  id                 String              @id
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  members            Member[]
  invitations        Invitation[]
  interviewSessions  InterviewSession[]
  contextDocuments   ContextDocument[]
  notionConnections  NotionConnection[]
  notionOAuthStates  NotionOAuthState[]
  youtubeConnections YouTubeConnection[]
  youtubeOAuthStates YouTubeOAuthState[]
  issueReports       IssueReport[]
  twinAssignments    TwinAssignment[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(60000)
  rateLimitMax        Int?      @default(120)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

model Organization {
  id                 String               @id
  name               String
  slug               String
  logo               String?
  websiteUrl         String?
  chromaTenantId     String?
  chromaDatabase     String               @default("default")
  createdAt          DateTime
  metadata           String?
  members            Member[]
  invitations        Invitation[]
  assignments        RolePlayAssignment[]
  twinAssignments    TwinAssignment[]
  twinShareLinks     TwinShareLink[]
  deployments        Deployment[]
  interviewSessions  InterviewSession[]
  knowledgeBases     KnowledgeBase[]
  knowledgeSources   KnowledgeSource[]
  notionConnections  NotionConnection[]
  notionOAuthStates  NotionOAuthState[]
  youtubeConnections YouTubeConnection[]
  youtubeOAuthStates YouTubeOAuthState[]
  issueReports       IssueReport[]
  avatars            Avatar[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String               @id
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // admin | team | user (CHECK member_role_check). admin and team run the studio; user only practises.
  role           String               @default("user")
  createdAt      DateTime
  // Set when a studio member disables this person (never deleted). Disabled people cannot sign in.
  disabledAt     DateTime?
  assignments    RolePlayAssignment[]

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Deployment {
  id                 String   @id @default(cuid())
  orgId              String
  agentId            String
  publicKey          String   @unique
  secretKeyHash      String?  @unique
  allowedModes       String   @default("chat,voice")
  allowedOrigins     Json?
  status             String   @default("active") // active | disabled
  rateLimitPerMinute Int      @default(30)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent        Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  assignments  RolePlayAssignment[]
  sessions     InterviewSession[]

  @@unique([orgId, agentId])
  @@index([orgId, status])
}

model RolePlayAssignment {
  id               String    @id @default(cuid())
  orgId            String
  deploymentId     String
  memberId         String?
  recipientEmail   String
  assignedByUserId String
  shareCode        String    @unique
  mode             String    @default("voice") // voice | chat
  status           String    @default("pending") // pending | used | expired | cancelled
  assignedAt       DateTime  @default(now())
  expiresAt        DateTime
  usedAt           DateTime?

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deployment   Deployment         @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  member       Member?            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sessions     InterviewSession[]

  @@unique([deploymentId, memberId])
  @@index([deploymentId, recipientEmail])
  @@index([orgId, memberId])
  @@index([shareCode, status])
}

model WorkspaceCommand {
  id          String    @id
  sessionId   String
  tool        String
  input       Json
  status      String    @default("pending") // pending | completed | failed
  result      Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, createdAt])
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("user") // admin | team | user (CHECK invitation_role_check)
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---- Connectors and Ingestion Models ----

model KnowledgeSource {
  id           String    @id @default(cuid())
  orgId        String
  kbId         String
  connector    String // upload | notion | notion_public | youtube
  externalId   String
  identityKey  String    @unique
  sourceUrl    String
  status       String    @default("active") // active | syncing | failed | unavailable | expiring
  lastSyncedAt DateTime?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kb           KnowledgeBase        @relation(fields: [kbId], references: [id], onDelete: Cascade)
  notion       NotionSourceConfig?
  youtube      YouTubeSourceConfig?
  documents    KnowledgeDocument[]
  jobs         IngestionJob[]

  @@index([orgId])
  @@index([kbId])
  @@index([connector, status])
}

model NotionSourceConfig {
  sourceId     String  @id
  connectionId String?
  accessMode   String // owned | public

  source     KnowledgeSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  connection NotionConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([connectionId])
}

model YouTubeSourceConfig {
  sourceId         String    @id
  connectionId     String
  captionId        String?
  captionUpdatedAt DateTime?
  fetchedAt        DateTime?

  source     KnowledgeSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  connection YouTubeConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([connectionId])
  @@index([fetchedAt])
}

model IngestionJob {
  id              String    @id @default(cuid())
  sourceId        String
  activeKey       String?
  status          String    @default("queued") // queued | running | succeeded | failed
  stage           String?
  itemsDiscovered Int       @default(0)
  itemsProcessed  Int       @default(0)
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  source    KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  workItems IngestionWorkItem[]

  @@index([sourceId, status])
  @@index([status, createdAt])
  @@index([activeKey])
}

model IngestionWorkItem {
  id               String    @id @default(cuid())
  jobId            String
  workKey          String
  parentWorkItemId String?
  kind             String    @default("resource") // resource | segment | publish
  payload          Json?
  status           String    @default("queued") // pending | queued | running | succeeded | failed
  artifactKey      String?
  artifactHash     String?
  chunkCount       Int       @default(0)
  attemptCount     Int       @default(0)
  leaseExpiresAt   DateTime?
  enqueuedAt       DateTime?
  processedAt      DateTime?
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  job      IngestionJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  parent   IngestionWorkItem?  @relation("IngestionWorkTree", fields: [parentWorkItemId], references: [id], onDelete: SetNull)
  children IngestionWorkItem[] @relation("IngestionWorkTree")

  @@unique([jobId, workKey])
  @@index([jobId, status])
  @@index([status, leaseExpiresAt])
  @@index([parentWorkItemId])
}

model YouTubeConnection {
  id                     String    @id @default(cuid())
  orgId                  String
  userId                 String
  channelId              String
  channelTitle           String
  status                 String    @default("active")
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  tokenExpiresAt         DateTime?
  refreshLeaseId         String?
  refreshLeaseExpiresAt  DateTime?
  lastVerifiedAt         DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization  Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConfigs YouTubeSourceConfig[]

  @@unique([orgId, channelId])
  @@index([orgId, userId])
  @@index([status, lastVerifiedAt])
}

model YouTubeOAuthState {
  id           String    @id
  orgId        String
  userId       String
  kbId         String
  codeVerifier String
  expiresAt    DateTime
  consumedAt   DateTime?

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kb           KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model NotionConnection {
  id                     String    @id @default(cuid())
  orgId                  String
  userId                 String
  workspaceId            String
  workspaceName          String?
  workspaceIcon          String?
  botId                  String?
  accessTokenCiphertext  String
  refreshTokenCiphertext String?
  tokenExpiresAt         DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization  Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConfigs NotionSourceConfig[]

  @@unique([orgId, workspaceId])
  @@index([orgId, userId])
}

model NotionOAuthState {
  id         String    @id
  orgId      String
  userId     String
  kbId       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kb           KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  @@index([expiresAt])
}

enum TopicStatus {
  proposed
  approved
}

model Topic {
  id          String      @id @default(cuid())
  slug        String      @unique
  description String
  status      TopicStatus @default(approved)
  createdAt   DateTime    @default(now())
}

// User-submitted "Report an issue" entries from the studio chrome.
// userId/orgId are nullable FKs (SetNull) so reports survive account/org deletion.
model IssueReport {
  id        String   @id @default(cuid())
  kind      String   @default("bug") // bug | feature | other
  message   String
  status    String   @default("open") // open | triaged | resolved | closed
  url       String?
  userAgent String?
  userId    String?
  orgId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  org  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([userId])
}

// ---- Usage metering ----

// Append-only ledger of raw usage (tokens, audio seconds, characters). One row per
// metric per event; prices/credits are computed later from these rows, never stored here.
// No FK relations on purpose: billing history must survive user/org/session deletion.
model UsageEvent {
  id             String   @id @default(cuid())
  orgId          String
  userId         String?
  sessionId      String?
  source         String // voice_agent | chat | copilot | report | synthesis | spec | rerank | evaluate | runtime
  provider       String // e.g. vercel | Deepgram | Sarvam | livekit
  model          String
  metric         String // input_tokens | output_tokens | cache_read_tokens | ... | stt_seconds | tts_characters | cost_usd
  quantity       Float
  idempotencyKey String   @unique
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
}

// Last running total received per producer stream (e.g. one LiveKit agent job), used to
// turn cumulative snapshots into deltas so lost/retried posts never lose or double-count.
model UsageCursor {
  streamId  String
  provider  String
  model     String
  metric    String
  lastValue Float
  updatedAt DateTime @updatedAt

  @@id([streamId, provider, model, metric])
}

// ---- Twin access (migration twin_access) ----
// Role plays keep RolePlayAssignment (email invite, 30 days, one attempt). Twins are assigned per user with a
// minutes budget; one budget per twin agent. Agent kind TWIN and same org are enforced by DB triggers.

/// A common link for one twin: each signed-in user who opens it gets their own TwinAssignment.
model TwinShareLink {
  id              String   @id @default(cuid())
  orgId           String
  agentId         String
  code            String   @unique
  minutesPerUser  Int // > 0 (CHECK)
  status          String   @default("active") // active | disabled
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent        Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  assignments  TwinAssignment[]

  @@index([agentId])
}

/// One user's access to one twin agent, with a minutes budget. No expiry for now.
model TwinAssignment {
  id               String   @id @default(cuid())
  orgId            String
  agentId          String
  recipientEmail   String // lower case (CHECK); one assignment per user per twin
  userId           String?
  minutesLimit     Int // > 0 (CHECK)
  shareCode        String   @unique // personal invite link
  shareLinkId      String?
  assignedByUserId String?
  status           String   @default("active") // active | revoked
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  shareLink    TwinShareLink?     @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  sessions     InterviewSession[]

  @@unique([agentId, recipientEmail])
  @@index([orgId, status])
  @@index([userId])
}

// ---- Twin turn evidence (migration twin_turn_evidence) ----
// Why a twin said what it said, one row per brain turn of a twin session: what it heard, what it looked up and the
// moments that came back (data: heard, reply, inputKind, calls). Posted by the chat runtime after each turn; shown as
// "Why this answer" on the calibration call.
model TwinTurnEvidence {
  id        String   @id @default(cuid())
  sessionId String
  data      Json
  createdAt DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ---- Twin calibration (migration twin_calibration) ----
// A studio member (admin / team) talks to a twin and marks its replies "feels like me" or "feels off".
// The call is a normal twin InterviewSession (transcript, duration, recording live there); the session's
// agent must be a TWIN (DB trigger).

/// One calibration call: 1:1 with its session.
model TwinCalibration {
  id              String   @id @default(cuid())
  sessionId       String    @unique
  createdByUserId String
  createdAt       DateTime  @default(now())
  /// Jev's count after the call: the trainer's real turns (not feedback or noise) and the "Feels off" they meant
  /// (mis-clicks left out). Accuracy = (turns - offTurns) / turns. Null until scored (lists fall back to raw counts).
  turns           Int?
  offTurns        Int?
  scoredAt        DateTime?

  session InterviewSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ratings TwinCalibrationRating[]
}

/// One rated twin reply. The text is kept as rated, so the review shows exactly what was judged.
model TwinCalibrationRating {
  id            String   @id @default(cuid())
  calibrationId String
  turnIndex     Int // position in the call's turns (>= 0, CHECK)
  question      String? // what the trainer said just before
  reply         String
  rating        String // like | off (CHECK)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  calibration TwinCalibration @relation(fields: [calibrationId], references: [id], onDelete: Cascade)

  @@unique([calibrationId, turnIndex])
}
