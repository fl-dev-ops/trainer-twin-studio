generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Studio specs ----

model Persona {
  orgId     String?
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  version   Int      @default(1)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model Agent {
  orgId      String?
  visibility String   @default("public") // public | private (within the org)
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  version    Int      @default(1)
  domainSlug String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId])
}

model Domain {
  orgId     String?
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  version   Int      @default(1)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// Immutable snapshot taken on every changed save. entityData in {persona|agent|domain}

model SpecVersion {
  orgId      String?
  id         String   @id @default(cuid())
  entityType String
  entitySlug String
  version    Int
  data       Json
  createdAt  DateTime @default(now())

  @@unique([entityType, entitySlug, version])
  @@index([entityType, entitySlug])
  @@index([orgId])
}

// ---- Copilot working drafts ----

model SpecDraft {
  orgId         String?
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  personaSlug   String?
  agentData     Json
  domainData    Json
  groundingData Json
  assumptions   Json
  gaps          Json
  status        String    @default("draft") // draft | published
  revision      Int       @default(1)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  revisions SpecDraftRevision[]

  @@index([orgId])
}

model SpecDraftRevision {
  id        String   @id @default(cuid())
  draftId   String
  revision  Int
  data      Json
  createdAt DateTime @default(now())

  draft SpecDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, revision])
  @@index([draftId])
}

// Invite-only platform: a founder invite authorizes one person to create one
// organization (with themselves as owner) through the onboarding flow.
model FounderInvite {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String?
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("founder_invite")
}

// ---- Knowledge ----

model KnowledgeBase {
  orgId     String?
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  documents          KnowledgeDocument[]
  sources            KnowledgeSource[]
  notionOAuthStates  NotionOAuthState[]
  youtubeOAuthStates YouTubeOAuthState[]

  @@index([orgId])
}

model KnowledgeSource {
  id           String    @id @default(cuid())
  orgId        String
  kbId         String
  connector    String
  externalId   String
  identityKey  String    @unique
  sourceUrl    String
  status       String    @default("active") // active | syncing | failed | unavailable | expiring
  lastSyncedAt DateTime?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kb           KnowledgeBase        @relation(fields: [kbId], references: [id], onDelete: Cascade)
  notion       NotionSourceConfig?
  youtube      YouTubeSourceConfig?
  documents    KnowledgeDocument[]
  jobs         IngestionJob[]

  @@index([orgId])
  @@index([kbId])
  @@index([connector, status])
}

model NotionSourceConfig {
  sourceId     String  @id
  connectionId String?
  accessMode   String // owned | public

  source     KnowledgeSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  connection NotionConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([connectionId])
}

model YouTubeSourceConfig {
  sourceId         String    @id
  connectionId     String
  captionId        String?
  captionUpdatedAt DateTime?
  fetchedAt        DateTime?

  source     KnowledgeSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  connection YouTubeConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([connectionId])
  @@index([fetchedAt])
}

model KnowledgeDocument {
  id                String    @id @default(cuid())
  kbId              String
  sourceId          String?
  externalId        String?
  externalUpdatedAt DateTime?
  parentExternalId  String?
  slug              String
  title             String
  ext               String
  size              Int
  s3SourceKey       String
  s3MarkdownKey     String?
  s3QuestionsKey    String?
  status            String    @default("uploaded") // uploaded | digesting | indexed | failed
  error             String?
  indexedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  kb     KnowledgeBase    @relation(fields: [kbId], references: [id], onDelete: Cascade)
  source KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([kbId, slug])
  @@unique([sourceId, externalId])
  @@index([sourceId])
}

/// One execution attempt to synchronize a KnowledgeSource.
/// Owns aggregate progress and completes only after every durable work item,
/// including final publication, has succeeded.
model IngestionJob {
  id              String    @id @default(cuid())
  sourceId        String
  activeKey       String?   @unique
  status          String    @default("queued") // queued | running | succeeded | failed
  stage           String?
  itemsDiscovered Int       @default(0)
  itemsProcessed  Int       @default(0)
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  source    KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  workItems IngestionWorkItem[]

  @@index([status, createdAt])
  @@index([sourceId])
}

/// One durable and idempotent unit of ingestion work processed through SQS.
/// A work item may represent a Notion page, YouTube transcript segment,
/// connector cursor, or final publication operation.
model IngestionWorkItem {
  id               String    @id @default(cuid())
  jobId            String
  workKey          String
  parentWorkItemId String?
  kind             String    @default("resource") // resource | segment | publish
  payload          Json?
  status           String    @default("queued") // pending | queued | running | succeeded | failed
  artifactKey      String?
  artifactHash     String?
  chunkCount       Int       @default(0)
  attemptCount     Int       @default(0)
  leaseExpiresAt   DateTime?
  enqueuedAt       DateTime?
  processedAt      DateTime?
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  job      IngestionJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  parent   IngestionWorkItem?  @relation("IngestionWorkTree", fields: [parentWorkItemId], references: [id], onDelete: SetNull)
  children IngestionWorkItem[] @relation("IngestionWorkTree")

  @@unique([jobId, workKey])
  @@index([jobId, status])
  @@index([status, leaseExpiresAt])
  @@index([parentWorkItemId])
}

// ---- Learner context (resumes etc.) ----

// Trainer voice for TTS cloning. Audio + transcript in S3 under
// {basePrefix}/tts-voices/{id}/; identity is a cuid so names can never collide.

model Voice {
  orgId           String?
  id              String   @id @default(cuid())
  name            String
  kind            String   @default("cloned") // sample | cloned
  status          String   @default("ready") // ready | failed
  s3AudioKey      String
  s3TranscriptKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orgId])
}

model ContextDocument {
  orgId     String?
  id        String   @id @default(cuid())
  name      String
  mimeType  String
  content   Bytes
  size      Int
  createdAt DateTime @default(now())

  @@index([orgId])
}

// ---- Interview sessions ----

// Interview practice run by a signed-in user of an organization.
model InterviewSession {
  orgId          String?
  id             String    @id @default(cuid())
  personaSlug    String
  personaVersion Int
  agentSlug      String
  agentVersion   Int
  domainSlug     String
  domainVersion  Int
  status         String    @default("active") // active | completed | abandoned
  userId         String?
  contextName    String?
  transcript     Json?
  evidence       Json?
  s3AudioKey     String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  @@index([orgId])
}

model User {
  id                 String              @id
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  members            Member[]
  invitations        Invitation[]
  notionConnections  NotionConnection[]
  notionOAuthStates  NotionOAuthState[]
  youtubeConnections YouTubeConnection[]
  youtubeOAuthStates YouTubeOAuthState[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                 String              @id
  name               String
  slug               String
  logo               String?
  createdAt          DateTime
  metadata           String?
  members            Member[]
  invitations        Invitation[]
  knowledgeSources   KnowledgeSource[]
  notionConnections  NotionConnection[]
  notionOAuthStates  NotionOAuthState[]
  youtubeConnections YouTubeConnection[]
  youtubeOAuthStates YouTubeOAuthState[]

  @@unique([slug])
  @@map("organization")
}

model YouTubeConnection {
  id                     String    @id @default(cuid())
  orgId                  String
  userId                 String
  channelId              String
  channelTitle           String
  status                 String    @default("active")
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  tokenExpiresAt         DateTime?
  refreshLeaseId         String?
  refreshLeaseExpiresAt  DateTime?
  lastVerifiedAt         DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization  Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceConfigs YouTubeSourceConfig[]

  @@unique([orgId, userId, channelId])
  @@index([orgId, userId])
  @@index([status, lastVerifiedAt])
}

model YouTubeOAuthState {
  id           String    @id
  orgId        String
  userId       String
  kbId         String
  codeVerifier String
  expiresAt    DateTime
  consumedAt   DateTime?

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kb           KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model NotionConnection {
  id                     String    @id @default(cuid())
  orgId                  String
  userId                 String
  workspaceId            String
  workspaceName          String?
  workspaceIcon          String?
  botId                  String?
  accessTokenCiphertext  String
  refreshTokenCiphertext String?
  tokenExpiresAt         DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization  Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConfigs NotionSourceConfig[]

  @@unique([orgId, userId, workspaceId])
  @@index([orgId, userId])
}

model NotionOAuthState {
  id         String    @id
  orgId      String
  userId     String
  kbId       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kb           KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  @@index([expiresAt])
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// Canonical topic taxonomy for closed-set classification. "proposed" rows come
// from the doc-level LLM pass and need approval before wide use.
enum TopicStatus {
  proposed
  approved
}

model Topic {
  id          String      @id @default(cuid())
  slug        String      @unique
  description String
  status      TopicStatus @default(approved)
  createdAt   DateTime    @default(now())
}
