# bun test (NODE_ENV=test) loads this over .env: no real outside services in tests. The database is derived from
# .env (tests/setup/preload.ts): <dev database>_test, created fresh by bun run test:setup.
RESEND_API_KEY=
RAZORPAY_KEY_ID=rzp_test_fake
RAZORPAY_KEY_SECRET=fake-secret
RAZORPAY_WEBHOOK_SECRET=test-webhook-secret
# Outside services on hosts that don't exist: flows answer them with MSW (tests/flows/harness.ts), and anything else
# fails instead of reaching a real service.
LIVEKIT_URL=wss://livekit.test
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.test
LIVEKIT_API_KEY=test-livekit-key
LIVEKIT_API_SECRET=test-livekit-secret-that-is-long-enough-to-sign
CHAT_URL=http://chat.test
COPILOT_SERVICE_SECRET=test-service-secret
S3_BUCKET=
AWS_S3_BUCKET=
