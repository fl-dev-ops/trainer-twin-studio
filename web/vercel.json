{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh scripts/vercel-build.sh",
  "fluid": true,
  "crons": [
    {
      "path": "/api/internal/ingestion/pump",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/internal/uploads/expire",
      "schedule": "30 3 * * *"
    }
  ]
}
